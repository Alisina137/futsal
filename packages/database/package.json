{
  "name": "@leaguekick/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "drizzle"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:kit": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed:roles": "node scripts/seed-role-demos.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11"
  }
}
