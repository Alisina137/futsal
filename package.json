{
  "name": "leaguekick",
  "version": "0.1.0",
  "private": true,
  "description": "Futsal mobile-first venue booking, operations, competitions, and community platform.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "node scripts/dev-api.mjs",
    "dev:mobile": "pnpm --filter @leaguekick/mobile exec expo start --tunnel --clear --go",
    "dev:admin": "node scripts/dev-admin.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "verify": "pnpm verify:admin-web && pnpm verify:suspension && pnpm verify:auth-model && pnpm verify:phase8 && pnpm verify:avatar && pnpm verify:post-time && pnpm verify:dev-api && pnpm verify:data-cache && pnpm verify:media && pnpm verify:analysis && pnpm verify:venue-settings && pnpm verify:timetable && pnpm verify:loading-ux && pnpm verify:mobile-rtl && pnpm verify:navigation && pnpm verify:role-dashboard && pnpm verify:role-subscription && pnpm verify:normal-user && pnpm verify:notifications-center && pnpm verify:public-home-nav && pnpm verify:followed-venues && pnpm verify:venue-recommendations && pnpm verify:default-location && pnpm verify:venue-discovery && pnpm verify:venue-cards && pnpm verify:facebook-home && pnpm verify:optimistic-likes && pnpm verify:comment-sheet && pnpm verify:social-comments && pnpm verify:team-directory && pnpm verify:social-directories && pnpm verify:role-demo && pnpm verify:trial-datetime && pnpm verify:phase7 && pnpm verify:phase6 && pnpm verify:competition-profile && pnpm verify:competition-organizer-invite && pnpm verify:offline-teams && pnpm verify:team-manager-phase1 && pnpm verify:team-join-requests && pnpm verify:team-manager-phase2 && pnpm verify:team-manager-phase3 && pnpm verify:player-dashboard-phase1 && pnpm verify:player-dashboard-phase2 && pnpm verify:competition-rewards && pnpm verify:match-details && pnpm verify:league-standings && pnpm verify:phase5 && pnpm verify:phase4 && pnpm verify:phase3 && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @leaguekick/database db:generate",
    "db:migrate": "pnpm --dir packages/database run db:migrate",
    "verify:phase3": "node scripts/verify-phase3-resilience.mjs",
    "verify:phase6": "node scripts/verify-phase6-competition.mjs",
    "verify:competition-profile": "node scripts/verify-competition-public-profile.mjs",
    "verify:competition-organizer-invite": "node scripts/verify-competition-organizer-invite.mjs",
    "verify:offline-teams": "node scripts/verify-offline-teams.mjs",
    "verify:competition-rewards": "node scripts/verify-competition-rewards.mjs",
    "verify:match-details": "node scripts/verify-match-details.mjs",
    "verify:league-standings": "node scripts/verify-league-standings.mjs",
    "verify:phase5": "node scripts/verify-phase5-teams.mjs",
    "verify:phase4": "node scripts/verify-phase4-marketing.mjs",
    "verify:mobile-rtl": "node scripts/verify-mobile-rtl-navigation.mjs",
    "verify:loading-ux": "node scripts/verify-mobile-loading-ux.mjs",
    "verify:timetable": "node scripts/verify-venue-timetable.mjs",
    "verify:dev-api": "node --check scripts/dev-api.mjs",
    "verify:data-cache": "node scripts/verify-mobile-data-cache.mjs",
    "verify:media": "node scripts/verify-owner-media.mjs",
    "verify:trial-datetime": "node scripts/verify-trial-datetime.mjs",
    "verify:phase7": "node scripts/verify-phase7-commercial.mjs",
    "verify:phase8": "node scripts/verify-phase8-release.mjs",
    "release:check": "pnpm verify",
    "verify:auth-model": "node scripts/verify-auth-identity-role-model.mjs",
    "verify:admin-web": "node scripts/verify-admin-web.mjs",
    "verify:suspension": "node scripts/verify-account-suspension.mjs",
    "verify:navigation": "node scripts/verify-mobile-header-navigation.mjs",
    "verify:normal-user": "node scripts/verify-normal-user-social.mjs",
    "verify:team-directory": "node scripts/verify-normal-user-team-directory.mjs",
    "verify:social-directories": "node scripts/verify-social-directories.mjs",
    "db:seed:roles": "pnpm --dir packages/database run db:seed:roles",
    "verify:role-demo": "node scripts/verify-role-demo-seed.mjs",
    "verify:role-dashboard": "node scripts/verify-role-dashboard.mjs",
    "verify:role-subscription": "node scripts/verify-role-subscription-ux.mjs",
    "verify:social-comments": "node scripts/verify-social-comments-profiles.mjs",
    "verify:analysis": "node scripts/verify-owner-analytics.mjs",
    "verify:venue-settings": "node scripts/verify-venue-settings.mjs",
    "verify:branding": "node scripts/verify-app-branding.mjs",
    "verify:avatar": "node scripts/verify-account-avatar.mjs",
    "verify:post-time": "node scripts/verify-relative-post-time.mjs",
    "verify:public-home-nav": "node scripts/verify-public-home-navigation.mjs",
    "verify:followed-venues": "node scripts/verify-followed-venues.mjs",
    "verify:notifications-center": "node scripts/verify-notifications-center.mjs",
    "verify:venue-recommendations": "node scripts/verify-venue-recommendations.mjs",
    "verify:default-location": "node scripts/verify-default-location.mjs",
    "verify:venue-discovery": "node scripts/verify-venue-discovery.mjs",
    "verify:venue-cards": "node scripts/verify-venue-result-cards.mjs",
    "verify:facebook-home": "node scripts/verify-facebook-home.mjs",
    "verify:optimistic-likes": "node scripts/verify-optimistic-social-likes.mjs",
    "verify:comment-sheet": "node scripts/verify-facebook-comment-sheet.mjs",
    "verify:team-manager-phase1": "node scripts/verify-team-manager-phase1.mjs",
    "verify:team-manager-phase2": "node scripts/verify-team-manager-phase2.mjs",
    "verify:team-join-requests": "node scripts/verify-team-join-requests.mjs",
    "verify:team-manager-phase3": "node scripts/verify-team-manager-phase3.mjs",
    "verify:player-dashboard-phase1": "node scripts/verify-player-dashboard-phase1.mjs",
    "verify:player-dashboard-phase2": "node scripts/verify-player-dashboard-phase2.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
