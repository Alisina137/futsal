{
  "name": "leaguekick",
  "version": "0.1.0",
  "private": true,
  "description": "Futsal mobile-first venue booking, operations, competitions, and community platform.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "node scripts/dev-api.mjs",
    "dev:mobile": "pnpm --filter @leaguekick/mobile exec expo start --tunnel --clear --go",
    "dev:admin": "node scripts/dev-admin.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "verify": "pnpm verify:admin-web && pnpm verify:suspension && pnpm verify:auth-model && pnpm verify:phase8 && pnpm verify:dev-api && pnpm verify:data-cache && pnpm verify:timetable && pnpm verify:loading-ux && pnpm verify:mobile-rtl && pnpm verify:navigation && pnpm verify:role-dashboard && pnpm verify:normal-user && pnpm verify:social-comments && pnpm verify:team-directory && pnpm verify:role-demo && pnpm verify:trial-datetime && pnpm verify:phase7 && pnpm verify:phase6 && pnpm verify:phase5 && pnpm verify:phase4 && pnpm verify:phase3 && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @leaguekick/database db:generate",
    "db:migrate": "pnpm --dir packages/database run db:migrate",
    "verify:phase3": "node scripts/verify-phase3-resilience.mjs",
    "verify:phase6": "node scripts/verify-phase6-competition.mjs",
    "verify:phase5": "node scripts/verify-phase5-teams.mjs",
    "verify:phase4": "node scripts/verify-phase4-marketing.mjs",
    "verify:mobile-rtl": "node scripts/verify-mobile-rtl-navigation.mjs",
    "verify:loading-ux": "node scripts/verify-mobile-loading-ux.mjs",
    "verify:timetable": "node scripts/verify-venue-timetable.mjs",
    "verify:dev-api": "node --check scripts/dev-api.mjs",
    "verify:data-cache": "node scripts/verify-mobile-data-cache.mjs",
    "verify:trial-datetime": "node scripts/verify-trial-datetime.mjs",
    "verify:phase7": "node scripts/verify-phase7-commercial.mjs",
    "verify:phase8": "node scripts/verify-phase8-release.mjs",
    "release:check": "pnpm verify",
    "verify:auth-model": "node scripts/verify-auth-identity-role-model.mjs",
    "verify:admin-web": "node scripts/verify-admin-web.mjs",
    "verify:suspension": "node scripts/verify-account-suspension.mjs",
    "verify:navigation": "node scripts/verify-mobile-header-navigation.mjs",
    "verify:normal-user": "node scripts/verify-normal-user-social.mjs",
    "verify:team-directory": "node scripts/verify-normal-user-team-directory.mjs",
    "db:seed:roles": "pnpm --dir packages/database run db:seed:roles",
    "verify:role-demo": "node scripts/verify-role-demo-seed.mjs",
    "verify:role-dashboard": "node scripts/verify-role-dashboard.mjs",
    "verify:social-comments": "node scripts/verify-social-comments-profiles.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
