# Use an HTTPS API URL for preview/production builds. A LAN HTTP address is acceptable only for local Expo development.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Optional support contact shown in release/support documentation. Do not put secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Only needed for standalone Android builds using native Google Maps (not Expo Go).
# Set a Google Maps SDK for Android key restricted to this app package/signing SHA-1.
# Supply this as an EAS build environment variable; never use EXPO_PUBLIC_ for credentials.
GOOGLE_MAPS_ANDROID_API_KEY=
