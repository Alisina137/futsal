{
  "expo": {
    "name": "Futsal",
    "slug": "leaguekick",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "leaguekick",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.leaguekick.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      }
    },
    "ios": {
      "bundleIdentifier": "com.leaguekick.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8FC",
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
