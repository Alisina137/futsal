# API
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
API_PORT=4000
CORS_ORIGIN=*
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_ISSUER=leaguekick-api
ACCESS_TOKEN_AUDIENCE=leaguekick-mobile

# Mobile (copy the line below into apps/mobile/.env.local and use your PC LAN IP or HTTPS tunnel on a physical phone)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
