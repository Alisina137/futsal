# Runtime mode. Production mode enables strict CORS/secret validation.
NODE_ENV=development

# API runtime — use Neon's pooled connection string here.
# Prefer verify-full so TLS certificate and hostname verification remain explicit.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full

# Drizzle migrations/schema operations — use Neon's direct connection string here.
# Falls back to DATABASE_URL only when this value is absent.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full

API_PORT=4000

# Local development may use *. Production must use one or more explicit HTTPS origins,
# separated by commas, for example: https://app.example.com,https://admin.example.com
CORS_ORIGIN=*

# Development placeholder only. Generate a unique high-entropy value for production.
# Production requires at least 48 characters and rejects obvious placeholders.
ACCESS_TOKEN_SECRET=replace-with-at-least-48-random-characters-in-production
ACCESS_TOKEN_ISSUER=leaguekick-api
ACCESS_TOKEN_AUDIENCE=leaguekick-mobile

# Included in health/readiness responses and support diagnostics; do not put secrets here.
APP_VERSION=1.0.0
REQUEST_LOGGING=true

# Mobile (copy the lines below into apps/mobile/.env.local).
# Use your PC LAN IP or HTTPS tunnel for local development; preview/production should use HTTPS.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_SUPPORT_EMAIL=
